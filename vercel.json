{
  "version": 2,
  "name": "discord-webhook-bot",
  "builds": [
    {
      "src": "index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", ".env"],
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/start",
      "dest": "/index.js"
    },
    {
      "src": "/.*",
      "dest": "/api/health.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "index.js": {
      "maxDuration": 300
    },
    "api/health.js": {
      "maxDuration": 10
    }
  }
}
