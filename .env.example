# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Make.com Webhook Configuration  
WEBHOOK_URL=https://hook.make.com/your_webhook_url_here

# Optional: Filter messages by specific channel IDs (comma-separated)
# CHANNEL_IDS=123456789012345678,987654321098765432

# Optional: Filter messages by specific guild/server IDs (comma-separated)
# GUILD_IDS=123456789012345678,987654321098765432

# Optional: Include messages from bots (default: false)
# INCLUDE_BOT_MESSAGES=false

# Optional: Enable debug logging (default: false)
# DEBUG=true

# Environment
NODE_ENV=production
