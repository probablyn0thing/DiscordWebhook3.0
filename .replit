modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "discord-bot-test"

[[workflows.workflow]]
name = "Discord Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm install -g typescript ts-node && npm install discord.js axios dotenv @types/node && ts-node index.ts"

[[workflows.workflow]]
name = "discord-bot-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm init -y && npm install discord.js axios dotenv && npm install -D typescript @types/node ts-node && npx tsc --build && node dist/index.js"

[deployment]
run = ["sh", "-c", "npm install && npm install -g typescript ts-node && npm install discord.js axios dotenv @types/node && ts-node index.ts"]
